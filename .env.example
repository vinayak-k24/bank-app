# Copy to .env. Mock mode needs no keys.
USE_MOCK_AI=true

# Local Gemini (Google AI Studio key)
GEMINI_API_KEY=

# Google Cloud / Vertex AI (set USE_VERTEX=true when deployed)
USE_VERTEX=false
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

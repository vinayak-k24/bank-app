# Copy to .env. Mock mode needs no keys.
USE_MOCK_AI=true

# Local Gemini (Google AI Studio key)
GEMINI_API_KEY=

# Google Cloud / Vertex AI (set USE_VERTEX=true when deployed)
USE_VERTEX=false
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# FraudShield BigQuery (teammate's pipeline). Auth: gcloud auth application-default login
USE_MOCK_BQ=true
BQ_PROJECT_ID=
BQ_DATASET=fraudshield
BQ_LOCATION=US

# Frontend origins allowed by CORS (comma-separated) and optional shared demo key (X-API-Key)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
API_KEY=
